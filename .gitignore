# Public CRSS release: only the listed source/configuration/docs are tracked.
# Local comparison implementations remain on disk but are never added normally.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/requirements.txt
!/environment.yml
!/run_extract.py
!/crss/
!/crss_two_stage/
!/training/
!/datasets/
!/features/
!/models/
!/utils/
!/vendor/
!/protocols/

# Publish only the CRSS production entry points.
!/scripts/
/scripts/*
!/scripts/__init__.py
!/scripts/extract_features.py
!/scripts/prepare_labels.py
!/scripts/run_crss.py
!/scripts/run_crss_matrix.py

# Publish only CRSS feature and training configurations.
!/configs/
/configs/*
!/configs/default.yaml
!/configs/server.yaml
!/configs/crss_two_stage.yaml

!/docs/
/docs/*
!/docs/METHOD.md
!/docs/MODELS.md
!/docs/RELEASE_NOTES.md
!/docs/source_manifest.json

!/assets/
/assets/*
!/assets/README.md
!/assets/framework.png

# Explicit local-only exclusions, including helpers used solely by baselines.
/baselines/
/aux_baselines/
/jumpteaching/
/methods/
/train_aux_baseline.py
/scripts/run_baselines.py
/scripts/run_lp_baselines.py
/scripts/run_jumpteaching.py
/scripts/extract_lp_features.py
/configs/baselines.yaml
/configs/multiview_baselines.yaml
/docs/BASELINES.md
/docs/LOCAL_WORKSPACE.md
/utils/feature_cache.py
/utils/feature_extractor.py

# Standalone copyright/license documents are kept only in the local workspace.
/vendor/LICENSE
LICENSE*
LICENCE*
COPYRIGHT*
NOTICE*
THIRD_PARTY_NOTICES*
license*
licence*
copyright*
notice*
third_party_notices*

# Generated artifacts, credentials, data and machine-specific files.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.env
.env.*
.idea/
.vscode/
/cache/
/features_cache/
/data/
/outputs/
/checkpoints/
/weights/
/tmp/
*.log
*.pt
*.pth
*.ckpt
*.safetensors
*.npy
*.npz
configs/local*.yaml
Thumbs.db
.DS_Store
