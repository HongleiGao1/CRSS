# Public CRSS: four entry scripts, one Python package and the paper image.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/requirements.txt
!/run_extract.py
!/prepare_labels.py
!/run_crss.py
!/run_crss_matrix.py
!/crss/
/crss/**
!/crss/**/
!/crss/**/*.py

!/assets/
/assets/*
!/assets/framework.png

# Keep the original local workspace and supplementary files off GitHub.
/configs/
/docs/
/protocols/
/scripts/
/vendor/
/crss_two_stage/
/datasets/
/features/
/models/
/training/
/utils/
/environment.yml

# Explicit local-only exclusions, including helpers used solely by baselines.
/baselines/
/aux_baselines/
/jumpteaching/
/methods/
/train_aux_baseline.py
/scripts/run_baselines.py
/scripts/run_lp_baselines.py
/scripts/run_jumpteaching.py
/scripts/extract_lp_features.py
/configs/baselines.yaml
/configs/multiview_baselines.yaml
/docs/BASELINES.md
/docs/LOCAL_WORKSPACE.md
/utils/feature_cache.py
/utils/feature_extractor.py

# Standalone copyright/license documents are kept only in the local workspace.
/vendor/LICENSE
LICENSE*
LICENCE*
COPYRIGHT*
NOTICE*
THIRD_PARTY_NOTICES*
license*
licence*
copyright*
notice*
third_party_notices*

